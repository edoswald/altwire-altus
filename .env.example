# Required
DATABASE_URL=                  # Shared Railway PostgreSQL connection string
ALTWIRE_WP_URL=                # https://altwire.net
ALTWIRE_WP_USER=               # WordPress admin username
ALTWIRE_WP_APP_PASSWORD=       # WordPress Application Password (spaces kept intact)
VOYAGE_API_KEY=                # Voyage AI API key (voyage-4 model)
VOYAGE_MODEL=voyage-4          # Embedding model; must be a Matryoshka model (voyage-3.5+) to use VOYAGE_EMBEDDING_DIMENSION
VOYAGE_EMBEDDING_DIMENSION=512 # Output dimension — 512 matches the existing altus_content embedding column (vector(512))
ANTHROPIC_API_KEY=             # For gallery synthesis via Claude Haiku
ANTHROPIC_BATCH_REVIEW_MODEL=claude-opus-4-6  # Shared batch review/audit model; do not set this to Fable for climb scoring
ANTHROPIC_CLIMB_SCORING_MODEL=claude-opus-4-8     # Dedicated mountaineering scoring model (rolled back from Fable)
ALTUS_WEEKLY_MODEL=claude-opus-4-8                # Weekly brief batch composition model (rolled back from Fable)
ALTUS_SYNTHESIS_BATCH_MODE=                       # Nightly synthesis batches by default; set to direct to opt out

# Matomo Analytics
ALTWIRE_MATOMO_URL=            # Matomo server URL (e.g. https://matomo.ozmediaservices.com/matomo/)
ALTWIRE_MATOMO_TOKEN_AUTH=     # Matomo API auth token
ALTWIRE_MATOMO_SITE_ID=        # Matomo site ID for altwire.net
ALTWIRE_MATOMO_START_DATE=     # Optional: historical seed start (YYYY-MM-DD, default 2024-12-01)
MINIMAX_API_KEY=               # Optional: preferred engine for historical analytics seed. If unset, the seed falls back to Anthropic; if neither is set it runs deterministically (--no-llm)

# Google Search Console
ALTWIRE_GSC_SERVICE_ACCOUNT_JSON=  # Full JSON service account key (single line)
ALTWIRE_GSC_SITE_URL=              # GSC site URL (e.g. https://altwire.net or sc-domain:altwire.net)

# Better Stack Monitoring
BETTER_STACK_TOKEN=            # Read-only Better Stack API token for uptime monitoring

# OAuth — one env var per named client, with owner/operator identity in the name
# Pattern: OAUTH_CLIENT_ID_<OPERATOR> and OAUTH_CLIENT_SECRET_<OPERATOR>
OAUTH_CLIENT_ID_DEREK=altus-derek
OAUTH_CLIENT_SECRET_DEREK=your-secret-here
OAUTH_CLIENT_ID_STAGING=altus-staging
OAUTH_CLIENT_SECRET_STAGING=staging-secret

# Redirect URI (optional — defaults to <MCP_BASE_URL>/oauth/callback)
OAUTH_REDIRECT_URI=https://your-altus-domain.com/oauth/callback

# Additional allowed redirect URIs beyond the primary (comma-separated)
OAUTH_ALLOWED_REDIRECT_URIS=https://your-altus-domain.com/oauth/callback,https://localhost:3000/oauth/callback

# MCP base URL (used in OAuth discovery endpoint and as fallback redirect base)
MCP_BASE_URL=https://your-altus-domain.com

# Per-client tool allowlists (optional — clients not listed here get full access)
# Format: clientId1:tool1,tool2;clientId2:tool1
OAUTH_CLIENT_TOOLS=

# Hal Chat UI — CORS and auth for /hal/auth, /hal/chat, and /events/*
# HAL_UI_ALLOWED_ORIGINS: comma-separated list of allowed browser origins.
# Leave unset to allow all origins (fine for private/beta deployments).
HAL_UI_ALLOWED_ORIGINS=         # e.g. https://hal.altwire.net,https://hal-staging.altwire.net

# Hal Chat UI auth — required to support AltWire admin login via /hal/auth
# These are shared with Nimbus; both services must use the same values.
HAL_SESSION_SECRET=            # Shared HMAC secret for signing/verifying session tokens (must match Nimbus)
HAL_KEY_DEREK_WEB=             # AltWire primary admin web API key — scope: operational
HAL_KEY_ED_WEB=                # Ed's web API key — scope: full (optional)
# Any additional HAL_KEY_<NAME>_WEB vars are auto-discovered and get scope: guest.
# Guest accounts have fully isolated onboarding state and preferences (scoped by name).
# The name shown in the Hal header is derived from the env var suffix, title-cased.
# Example: HAL_KEY_TEST_WEB=... → identity "Test", scope "guest", shown as "Hal / Test"
HAL_KEY_TEST_WEB=              # Beta test account — memory profile isolated from Derek's

# AltWire Slack forwarding — ALTWIRE_WEBHOOK_TOKEN must match Nimbus and Cumulus
NIMBUS_SLACK_WEBHOOK_URL=      # Nimbus compatibility receiver, e.g. https://nimbus.example/slack/altwire-events
ALTWIRE_WEBHOOK_TOKEN=         # Scoped shared secret sent as X-Altwire-Token

# Morning Digest Email
DEREK_EMAIL=                   # Digest recipient (Derek's email address)
ALTUS_CC_EMAILS=               # Comma-separated CC addresses for every digest — set your own address here for testing

# Optional
PORT=3000                      # Railway sets this automatically
TEST_MODE=false                # Set true to skip live API calls in tests
LOG_LEVEL=info
ALTUS_ADMIN_TOKEN=             # Bearer token for writer REST endpoints (/hal/writer/*)
ALTUS_WRITER_MODEL=            # AI model for writer pipeline (default: claude-sonnet-4-5). gpt-*/o1*/o3* → OpenAI; all else → Anthropic
ALTUS_CHAT_MODEL=              # Claude model for /hal/chat agentic loop (default: claude-sonnet-4-5)
OPENAI_API_KEY=                # Required only when ALTUS_WRITER_MODEL is set to an OpenAI model

# Editorial Intelligence (Topic Discovery, News Monitor, Performance Tracker)
# No new env vars required — reuses existing:
#   DATABASE_URL                      — PostgreSQL for agent_memory, article_performance, article_assignments
#   ALTWIRE_GSC_SERVICE_ACCOUNT_JSON  — GSC API for opportunity zone, News search type, page performance
#   ALTWIRE_GSC_SITE_URL              — GSC site URL
#   ANTHROPIC_API_KEY                 — Haiku for editorial pitch synthesis
